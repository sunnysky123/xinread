<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="xinread.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:xinread.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 根节点接管键盘：方向键翻章、PgUp/PgDn 翻页，见 OnReaderKeyDown。 -->
    <Grid x:Name="ReaderRoot" Loaded="OnReaderRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="ToolbarHost"
            Padding="16,12"
            ColumnSpacing="8"
            SizeChanged="OnToolbarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Click="OnBackClick"
                Content="← 书架" />

            <TextBlock
                x:Name="HeaderText"
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />

            <!-- 宽屏时的横向工具栏；窄屏时这些控件会被移到 ☰ 里竖向排列。 -->
            <StackPanel
                x:Name="ToolbarActions"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

            <Button
                x:Name="SpeakButton"
                AutomationProperties.Name="大声朗读"
                Click="OnSpeakClick"
                ToolTipService.ToolTip="大声朗读">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="SpeakGlyph" Text="&#x1F50A;" />
                    <TextBlock x:Name="SpeakLabel" Text="大声朗读" />
                </StackPanel>
            </Button>

            <Button
                x:Name="SpeakSettingsButton"
                AutomationProperties.Name="朗读设置"
                ToolTipService.ToolTip="朗读设置：语音、语速、音量">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#x2699;" />
                        <TextBlock Text="朗读设置" />
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnSpeakOptionsOpening">
                        <MenuFlyoutSubItem x:Name="VoiceMenu" Text="语音">
                            <MenuFlyoutItem Text="（载入中…）" IsEnabled="False" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="语速">
                            <RadioMenuFlyoutItem
                                x:Name="RateSlow"
                                GroupName="SpeechRate"
                                Text="慢（0.7×）"
                                Tag="0.7"
                                Click="OnSpeechRateClick" />
                            <RadioMenuFlyoutItem
                                x:Name="RateNormal"
                                GroupName="SpeechRate"
                                Text="正常（1.0×）"
                                Tag="1"
                                Click="OnSpeechRateClick" />
                            <RadioMenuFlyoutItem
                                x:Name="RateFast"
                                GroupName="SpeechRate"
                                Text="快（1.3×）"
                                Tag="1.3"
                                Click="OnSpeechRateClick" />
                            <RadioMenuFlyoutItem
                                x:Name="RateFaster"
                                GroupName="SpeechRate"
                                Text="更快（1.6×）"
                                Tag="1.6"
                                Click="OnSpeechRateClick" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="音量">
                            <RadioMenuFlyoutItem
                                x:Name="VolumeQuiet"
                                GroupName="SpeechVolume"
                                Text="小（30%）"
                                Tag="0.3"
                                Click="OnSpeechVolumeClick" />
                            <RadioMenuFlyoutItem
                                x:Name="VolumeNormal"
                                GroupName="SpeechVolume"
                                Text="中（70%）"
                                Tag="0.7"
                                Click="OnSpeechVolumeClick" />
                            <RadioMenuFlyoutItem
                                x:Name="VolumeLoud"
                                GroupName="SpeechVolume"
                                Text="大（100%）"
                                Tag="1"
                                Click="OnSpeechVolumeClick" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="AutoNextMenuItem"
                            Click="OnAutoNextClick"
                            Text="读完本章自动翻下一章" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="StopSpeakMenuItem"
                            Click="OnStopSpeakClick"
                            Text="停止朗读" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button
                x:Name="FontIncreaseButton"
                AutomationProperties.Name="增大字号"
                Click="OnIncreaseFontClick"
                Content="+"
                ToolTipService.ToolTip="增大字号" />

            <Button
                x:Name="FontDecreaseButton"
                AutomationProperties.Name="减小字号"
                Click="OnDecreaseFontClick"
                Content="−"
                ToolTipService.ToolTip="减小字号" />

            <ComboBox
                x:Name="ChapterBox"
                Width="260"
                PlaceholderText="选择章节"
                SelectionChanged="OnChapterSelected" />

            <Button
                x:Name="PrevButton"
                Click="OnPrevClick"
                Content="上一章"
                MinWidth="0" />

            <Button
                x:Name="NextButton"
                Click="OnNextClick"
                Content="下一章"
                MinWidth="0" />
            </StackPanel>

            <!-- 窄屏入口：点击后展开上面那些按钮（竖向排列）。 -->
            <Button
                x:Name="MenuButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="更多操作"
                Content="&#x2630;"
                FontSize="16"
                Visibility="Collapsed">
                <Button.Flyout>
                    <Flyout
                        x:Name="ActionsFlyout"
                        Opening="OnActionsFlyoutOpening"
                        Placement="BottomEdgeAlignedRight" />
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 提示条占独立一行，避免像浮层那样压住正文标题。 -->
        <StackPanel Grid.Row="1" Margin="16,0,16,0" Spacing="4">
            <InfoBar
                x:Name="SignInBar"
                IsClosable="True"
                IsOpen="False"
                Message="当前未登录，只能试看前 3 章。"
                Severity="Informational"
                Title="试看模式">
                <InfoBar.ActionButton>
                    <Button Click="OnSignInClick" Content="登录" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="NoticeBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="ContentScroller"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                IsTabStop="True"
                SizeChanged="OnContentScrollerSizeChanged"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel>
                    <StackPanel
                        x:Name="ContentPanel"
                        Padding="32,8,32,24" />

                    <!-- 章末翻章入口：不用滚回顶部就能继续读，按钮行为与工具栏完全一致。 -->
                    <StackPanel
                        x:Name="ChapterNav"
                        Margin="32,0,32,56"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="Collapsed">
                        <Button
                            x:Name="BottomPrevButton"
                            Click="OnPrevClick"
                            Content="← 上一章" />
                        <Button
                            x:Name="BottomNextButton"
                            Click="OnNextClick"
                            Content="下一章 →" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ProgressRing
                x:Name="LoadingRing"
                Width="48"
                Height="48"
                IsActive="False" />

            <TextBlock
                x:Name="Placeholder"
                Margin="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="正在载入…"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
