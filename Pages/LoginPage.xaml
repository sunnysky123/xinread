<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="xinread.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:xinread.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">
        <Button
            x:Name="BackButton"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="OnBackClick"
            Content="← 返回" />

        <StackPanel
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="登录微信读书" />

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="用微信扫描二维码，登录后即可读取书架和正文。" />

            <!--
                二维码底色必须固定为白色：深色主题下若跟随主题变暗，扫码会失败。
                这里显式写白色，与外面的卡片背景区分开。
            -->
            <Border
                Padding="12"
                HorizontalAlignment="Center"
                Background="White"
                CornerRadius="12">
                <Grid Width="260" Height="260">
                    <Image x:Name="QrImage" Stretch="Uniform" />
                    <ProgressRing
                        x:Name="QrProgress"
                        Width="48"
                        Height="48"
                        IsActive="True" />
                </Grid>
            </Border>

            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                Text="正在获取二维码…"
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ErrorBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <Button
                x:Name="RefreshButton"
                HorizontalAlignment="Center"
                Click="OnRefreshClick"
                Content="刷新二维码"
                IsEnabled="False" />
        </StackPanel>
    </Grid>
</Page>
