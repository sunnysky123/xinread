<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="xinread.Pages.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:xinread.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="24,16,24,8"
            ColumnSpacing="12"
            RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="我的书架" />

            <TextBlock
                x:Name="GuestHint"
                Grid.Row="1"
                Grid.ColumnSpan="6"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="登录后可同步书架与阅读进度；未登录时下面展示推荐书目，可试看前 3 章。"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="2"
                Width="220"
                VerticalAlignment="Center"
                PlaceholderText="搜索书名或作者"
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged" />

            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                Click="OnRefreshClick"
                Content="刷新" />

            <Button
                x:Name="SignOutButton"
                Grid.Column="4"
                VerticalAlignment="Center"
                Click="OnSignOutClick"
                Content="退出登录" />

            <Button
                x:Name="SignInButton"
                Grid.Column="5"
                VerticalAlignment="Center"
                Click="OnSignInClick"
                Content="登录"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="LoadingRing"
                Width="48"
                Height="48"
                IsActive="False" />

            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="书架是空的。"
                Visibility="Collapsed" />

            <InfoBar
                x:Name="ErrorBar"
                Margin="24,0"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <GridView
                x:Name="BooksView"
                Padding="24,8,24,24"
                IsItemClickEnabled="True"
                ItemClick="OnBookClick"
                ItemsSource="{x:Bind FilteredBooks}"
                SelectionMode="None"
                VerticalContentAlignment="Stretch">
                <GridView.ItemContainerStyle>
                    <!-- 书与书之间留出呼吸空间，默认相邻条目几乎贴在一起。 -->
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,24,24" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:ShelfBookItem">
                        <Grid
                            Width="132"
                            VerticalAlignment="Top"
                            RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" MinHeight="38" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Height="176"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <Grid>
                                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                    <!-- 下面两处文字叠在封面图上，用固定遮罩色 + 白字，与明暗主题无关。 -->
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="White"
                                        Text="{x:Bind ProgressLabel}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ProgressVisibility}" />
                                    <Border
                                        Margin="6"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#CC000000"
                                        CornerRadius="4"
                                        Visibility="{x:Bind BadgeVisibility}">
                                        <TextBlock
                                            Foreground="White"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Badge}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock
                                Grid.Row="1"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />

                            <TextBlock
                                Grid.Row="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Author}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
