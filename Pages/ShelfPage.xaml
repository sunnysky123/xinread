<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="xinread.Pages.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:xinread.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            标题栏随窗口宽度收缩：放得下时搜索框与按钮平铺，
            放不下时搜索收成放大镜图标，刷新与登录/退出一起收进 ☰（与阅读页一致）。
        -->
        <Grid
            x:Name="HeaderHost"
            Padding="24,16,24,8"
            ColumnSpacing="12"
            RowSpacing="4"
            SizeChanged="OnHeaderSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="我的书架" />

            <TextBlock
                x:Name="GuestHint"
                Grid.Row="1"
                Grid.ColumnSpan="5"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="登录后可同步书架与阅读进度；未登录时下面展示推荐书目，可试看前 3 章。"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="2"
                Width="220"
                VerticalAlignment="Center"
                PlaceholderText="搜索书名或作者"
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged" />

            <!-- 窄屏时的搜索入口：点击后在浮层里输入。 -->
            <Button
                x:Name="SearchButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="搜索"
                Click="OnSearchButtonClick"
                ToolTipService.ToolTip="搜索"
                Visibility="Collapsed">
                <SymbolIcon Symbol="Find" />
                <Button.Flyout>
                    <Flyout
                        x:Name="SearchFlyout"
                        Opening="OnSearchFlyoutOpening"
                        Placement="BottomEdgeAlignedRight">
                        <AutoSuggestBox
                            x:Name="CompactSearchBox"
                            Width="220"
                            PlaceholderText="搜索书名或作者"
                            QueryIcon="Find"
                            QuerySubmitted="OnCompactSearchSubmitted"
                            TextChanged="OnCompactSearchTextChanged" />
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--
                平铺态的操作区：刷新 + 登录态二选一（未登录显示「登录」，已登录显示「退出登录」）。
                窄屏时整块收进 ☰，菜单项由 OnActionsFlyoutOpening 按同样规则生成。
            -->
            <StackPanel
                x:Name="HeaderActions"
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="RefreshButton"
                    Click="OnRefreshClick"
                    Content="刷新" />

                <Button
                    x:Name="SignInButton"
                    Click="OnSignInClick"
                    Content="登录"
                    Style="{StaticResource AccentButtonStyle}" />

                <Button
                    x:Name="SignOutButton"
                    Click="OnSignOutClick"
                    Content="退出登录" />
            </StackPanel>

            <!-- 窄屏入口：点击后展开刷新与登录/退出（内容按当前登录状态重建）。 -->
            <Button
                x:Name="MenuButton"
                Grid.Column="4"
                VerticalAlignment="Center"
                AutomationProperties.Name="更多操作"
                Content="&#x2630;"
                FontSize="16"
                ToolTipService.ToolTip="更多操作"
                Visibility="Collapsed">
                <Button.Flyout>
                    <Flyout
                        x:Name="ActionsFlyout"
                        Opening="OnActionsFlyoutOpening"
                        Placement="BottomEdgeAlignedRight" />
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="LoadingRing"
                Width="48"
                Height="48"
                IsActive="False" />

            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="书架是空的。"
                Visibility="Collapsed" />

            <InfoBar
                x:Name="ErrorBar"
                Margin="24,0"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <GridView
                x:Name="BooksView"
                Padding="24,8,24,24"
                IsItemClickEnabled="True"
                ItemClick="OnBookClick"
                ItemsSource="{x:Bind FilteredBooks}"
                Loaded="OnBooksViewLoaded"
                SelectionMode="None"
                SizeChanged="OnBooksViewSizeChanged"
                VerticalContentAlignment="Top">
                <!--
                    列数与格宽由 UpdateBookCells 按可用宽度重算（见 .xaml.cs）。
                    交给默认算法时，列数按首张卡片的固定宽度算，一行铺不满的余量会全堆在行尾，
                    右侧留白于是明显比左侧宽。重算后每格等宽、N 格正好铺满一行，
                    卡片在格内居中，两侧留白因此始终相等。
                -->
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <!-- 卡片在格子里居中，格子比卡片宽出来的部分左右均分，就是书间距。 -->
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,0,24" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:ShelfBookItem">
                        <Grid
                            Width="132"
                            VerticalAlignment="Top"
                            RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" MinHeight="38" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Height="176"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6">
                                <Grid>
                                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                    <!-- 下面两处文字叠在封面图上，用固定遮罩色 + 白字，与明暗主题无关。 -->
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="White"
                                        Text="{x:Bind ProgressLabel}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ProgressVisibility}" />
                                    <Border
                                        Margin="6"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#CC000000"
                                        CornerRadius="4"
                                        Visibility="{x:Bind BadgeVisibility}">
                                        <TextBlock
                                            Foreground="White"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Badge}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock
                                Grid.Row="1"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top" />

                            <TextBlock
                                Grid.Row="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Author}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
