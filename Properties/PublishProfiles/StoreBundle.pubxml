<?xml version="1.0" encoding="utf-8"?>
<!--
  发布到 Microsoft Store 用的配置。

  用同一个发布目录让两种架构的产物汇合，再打包成一个 .msixbundle：
      dotnet publish -c Release -p:Platform=x64   /p:PublishProfile=StoreBundle
      dotnet publish -c Release -p:Platform=ARM64 /p:PublishProfile=StoreBundle

  产物：
      AppPackages\store\xinread_<版本>_x64_arm64_bundle.msixbundle
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!--
      自包含：把 .NET 运行时打进包里，用户无需预装 .NET。
    -->
    <SelfContained>true</SelfContained>

    <!--
      WinUI 3 不支持程序集裁剪：任何 PublishTrimmed=true 都会让应用在启动时
      崩在 Microsoft.UI.Xaml.dll（0xc000027b）。已实测 PublishTrimmed=true、
      TrimMode=copyused 均失败，因此必须保持 false。
      包体靠"细粒度 Windows App SDK 引用"来控制（去掉 AI/ML/onnx/DirectML），
      已把单架构包从 34MB 降到 12MB。
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Windows App SDK 以框架包依赖形式提供，由商店负责安装 -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <!--
      两种架构共用一个发布目录，供打包脚本收集后合成 bundle；
      最终交付物单独放在 AppPackages\store\bundle，避免与发布中间文件混在一起。
    -->
    <PublishDir>AppPackages\publish\</PublishDir>
    <AppxPackageDir>AppPackages\publish\</AppxPackageDir>

    <!-- 面向商店上传：不签名，由商店在认证通过后重新签名 -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>

    <!--
      这里只产出单架构的 .msix；多架构 bundle 由仓库根目录的 pack-store.ps1
      用 MakeAppx bundle 合成。原因：bundle 目标会在每次构建时清空同目录，
      先构建 x64 再构建 ARM64 会把前者的产物冲掉。
    -->
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>

    <!--
      商店上传不需要符号包。生成符号包依赖 mspdbcmf.exe（随 Windows SDK 的可选组件
      安装），本机没有时会直接让构建失败，因此显式关闭。
    -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>
</Project>
